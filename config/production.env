# Digital Vault Heritage v3.0 - Production Environment Configuration
# This file contains production-specific environment variables
# DO NOT commit this file to version control

# =============================================================================
# PRODUCTION APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=Digital Vault Heritage
APP_VERSION=3.0.0
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_LOG_LEVEL=warning

# =============================================================================
# PRODUCTION SECURITY CONFIGURATION
# =============================================================================
# Enhanced security for production
ENCRYPTION_ITERATIONS=200000
ENCRYPTION_SALT_LENGTH=32
ENCRYPTION_KEY_LENGTH=32

# Stricter session management
SESSION_TIMEOUT_HOURS=12
SESSION_MAX_AGE_DAYS=3

# Stricter rate limiting
MAX_LOGIN_ATTEMPTS=3
LOGIN_ATTEMPT_WINDOW_MINUTES=10
MAX_PIN_ATTEMPTS=3
PIN_ATTEMPT_WINDOW_MINUTES=5
MAX_RECOVERY_ATTEMPTS=2
RECOVERY_ATTEMPT_WINDOW_HOURS=2

# =============================================================================
# PRODUCTION STRIPE CONFIGURATION
# =============================================================================
# Replace with your actual production Stripe keys
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
STRIPE_SECRET_KEY=sk_live_your_production_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Production price IDs
STRIPE_PRICE_PREMIUM_MONTHLY=price_premium_monthly_prod
STRIPE_PRICE_PREMIUM_YEARLY=price_premium_yearly_prod
STRIPE_PRICE_LIFETIME=price_lifetime_prod

# =============================================================================
# PRODUCTION FIREBASE CONFIGURATION
# =============================================================================
# Replace with your production Firebase project settings
FIREBASE_PROJECT_ID=digital-vault-heritage-prod
FIREBASE_API_KEY=your_production_firebase_api_key
FIREBASE_AUTH_DOMAIN=digital-vault-heritage-prod.firebaseapp.com
FIREBASE_DATABASE_URL=https://digital-vault-heritage-prod.firebaseio.com
FIREBASE_STORAGE_BUCKET=digital-vault-heritage-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_production_sender_id
FIREBASE_APP_ID=your_production_app_id

# =============================================================================
# PRODUCTION NOTIFICATION SERVICES
# =============================================================================
# Production email service
EMAIL_SERVICE_ENDPOINT=https://api.production-email-service.com
EMAIL_SERVICE_API_KEY=prod_email_service_api_key_secure
EMAIL_FROM_ADDRESS=noreply@digitalvault.com
EMAIL_FROM_NAME=Digital Vault Heritage

# Production SMS service
SMS_SERVICE_ENDPOINT=https://api.production-sms-service.com
SMS_SERVICE_API_KEY=prod_sms_service_api_key_secure
SMS_FROM_NUMBER=+1234567890

# Production push notification service
PUSH_SERVICE_ENDPOINT=https://api.production-push-service.com
PUSH_SERVICE_API_KEY=prod_push_service_api_key_secure

# =============================================================================
# PRODUCTION DATABASE CONFIGURATION
# =============================================================================
# Production database (replace with actual values)
DATABASE_URL=postgresql://username:password@prod-db-host:5432/digital_vault_prod
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT_SECONDS=30
DATABASE_SSL_MODE=require

# =============================================================================
# PRODUCTION EXTERNAL SERVICES
# =============================================================================
# Production Dead Man's Switch services
DEAD_MANS_SWITCH_WEBHOOK_URL=https://api.production-service.com/webhook
DEAD_MANS_SWITCH_BACKUP_URL=https://backup-api.production-service.com

# Production security logging
SECURITY_LOG_ENDPOINT=https://api.production-security-service.com/logs
SECURITY_LOG_API_KEY=prod_security_log_api_key_secure

# =============================================================================
# PRODUCTION MONITORING & ANALYTICS
# =============================================================================
# Error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_ERROR_TRACKING=true

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
ENABLE_ANALYTICS_TRACKING=true

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1

# =============================================================================
# PRODUCTION COMPLIANCE & LEGAL
# =============================================================================
# GDPR and compliance
ENABLE_GDPR_COMPLIANCE=true
ENABLE_DATA_RETENTION=true
DATA_RETENTION_DAYS=2555  # 7 years
ENABLE_AUDIT_LOGGING=true

# =============================================================================
# PRODUCTION BACKUP & RECOVERY
# =============================================================================
# Production backup configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_ENABLED=true

# Production recovery
ENABLE_EMERGENCY_RECOVERY=true
EMERGENCY_CONTACT_EMAIL=emergency@digitalvault.com
EMERGENCY_PHONE=+1234567890

# =============================================================================
# PRODUCTION API CONFIGURATION
# =============================================================================
# Production API settings
API_VERSION=v3
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
API_TIMEOUT_SECONDS=30
ENABLE_API_CACHING=true

# Production CORS
CORS_ALLOWED_ORIGINS=https://digitalvault.com,https://app.digitalvault.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key

# =============================================================================
# PRODUCTION FEATURE FLAGS
# =============================================================================
# Production feature settings
ENABLE_DEAD_MANS_SWITCH=true
ENABLE_CONDITIONAL_INHERITANCE=true
ENABLE_MULTI_CHANNEL_CHECKIN=true
ENABLE_GRACE_PERIOD=true
ENABLE_USER_REPORTING=true
ENABLE_ADVANCED_LOGGING=true

# Production beta features
ENABLE_BETA_FEATURES=false
ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# PRODUCTION MAINTENANCE & OPERATIONS
# =============================================================================
# Production maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Digital Vault Heritage is temporarily under maintenance. Your data is secure and will be available shortly.

# Health checks
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL_MINUTES=2

# =============================================================================
# PRODUCTION LEGAL & PRIVACY
# =============================================================================
# Production legal URLs
PRIVACY_POLICY_URL=https://digitalvault.com/privacy
TERMS_OF_SERVICE_URL=https://digitalvault.com/terms

# Production cookie consent
ENABLE_COOKIE_CONSENT=true
COOKIE_CONSENT_VERSION=1.0

# =============================================================================
# PRODUCTION BUILD & DEPLOYMENT
# =============================================================================
# Production build info
BUILD_NUMBER=1
BUILD_DATE=2024-05-05
COMMIT_HASH=prod_abcd1234

# Production deployment
DEPLOY_ENVIRONMENT=production
DEPLOY_REGION=us-west-2
DEPLOY_VERSION=3.0.0

# =============================================================================
# PRODUCTION SECURITY HEADERS
# =============================================================================
# Security headers for web (if applicable)
ENABLE_SECURITY_HEADERS=true
STRICT_TRANSPORT_SECURITY=true
CONTENT_SECURITY_POLICY=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
